   "source": [
    "import numpy as np\n",
    "\n",
    "a = np.array([1,2,3,4]).reshape(2,2)\n",
    "b = np.array([3,-2,1,4]).reshape(2,2)\n",
    "\n",
    "print(f\" a =\\n {a}\")\n",
    "print(f\" b =\\n {b}\")\n",
    "print(f\" a @ b =\\n {a @ b}\")\n"
   ]
